    },
    {
      "@type": "dcat:Distribution",
      "dct:title": "TDA/NTD reporting-slice feasibility record",
      "dct:description": "The four-field reporting slice and the recorded feasibility assessment behind it.",
      "dcat:accessURL": "https://transit.chelseakr.com/data/tda-ntd-feasibility.json",
      "dcat:downloadURL": "https://transit.chelseakr.com/data/tda-ntd-feasibility.json",
      "dcat:mediaType": "application/json",
